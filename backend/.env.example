PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/cm_kerala_grievance?retryWrites=true&w=majority&appName=CMKeralaPortal
JWT_SECRET=replace_with_a_long_random_jwt_secret_string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
AUTO_SEED_IF_EMPTY=true
SERVE_FRONTEND=false
