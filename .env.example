# =============================================================================
# CM Kerala Public Grievance Redressal Portal - Root Environment Example
# Copy to backend/.env and frontend/.env (never commit real secrets!)
# =============================================================================

# --- Backend Server ---
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (replace placeholders with your cluster details)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/cm_kerala_grievance?retryWrites=true&w=majority&appName=CMKeralaPortal

# JWT Configuration (use a strong random secret in production, min 32 chars)
JWT_SECRET=replace_with_a_long_random_jwt_secret_string
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Google Gemini API for Mandatory AI Grievance Assistant
# Get a free-tier key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Auto-seed fictional demo data when database has zero departments (true/false)
AUTO_SEED_IF_EMPTY=true

# Optional: Set true if Express should serve frontend/dist in single-service deploy
SERVE_FRONTEND=false

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:5000/api
